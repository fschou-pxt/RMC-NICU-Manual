---
// Home page: hero with search and quick actions, quick-link cards, what's new, the manual by part, about.
// The page text lives in src/content/docs/index.mdx; this component lays it out.
import chapters from "../chapters.json";
import Icon from "./KpIcon.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path) => (/^https?:/.test(path) ? path : base + path);

const quick = [
  ["phone", "Phone numbers", "RMC, regional NICUs, subspecialty consults", "phone-numbers"],
  ["clipboard", "Dot phrases", "Note templates, ready to copy", "dotPhrases"],
  ["hospital", "Admission", "Central lines, UVC/UAC, re-admission", "admission"],
  ["lungs", "Respiratory", "LISA, support guide, HFJV, extubation", "respiratory"],
  ["droplet", "Nutrition and fluids", "Feeding, TPN, KVO rates, Prolacta", "nutrition-fluid"],
  ["snow", "Therapeutic hypothermia", "Eligibility, passive cooling", "neurology#sec-th-protocol"],
  ["heart", "VLBW / ELGAN", "Thermoregulation, screening, ROP", "VLBW"],
  ["home", "Discharge", "Criteria, HRIF, navigator", "discharge"],
  ["people", "Agreements", "Radiology, Peds–Neo FCC", "operations#sec-interdept-agreements"],
  ["calculator", "Calculators", "Feeding plan, GIR, fluids, and more", "calculators"],
];

// the manual's parts, in book order (titles read from each chapter)
const docs = import.meta.glob("../content/docs/*.mdx", { eager: true });
const titleOf = (slug) => docs[`../content/docs/${slug}.mdx`]?.frontmatter?.title ?? slug;
const parts = [];
for (const ch of chapters) {
  if (ch.slug === "index") continue;
  let p = parts.find((x) => x.name === ch.part);
  if (!p) parts.push((p = { name: ch.part, items: [] }));
  p.items.push({ slug: ch.slug, title: titleOf(ch.slug), number: ch.number });
}
const { editor, editorEmail, authors = [], donate } = Astro.props;
const askOn = process.env.ASK !== "off"; // ASK=off at build time: launch baseline without Ask
---

<div class="home">
  <section class="home-hero">
    <p class="eyebrow">KP Riverside · Neonatal ICU</p>
    <h1>NICU Manual</h1>
    <p class="lede">Unit protocols, guidelines, and dot phrases, approved by our neonatologists and NICU staff.</p>
    <button type="button" class="home-search" data-home-search>
      <Icon name="search" /><span class="long">Search protocols, doses, phone numbers…</span><span class="short">Search the manual</span><kbd data-shortcut>Ctrl K</kbd>
    </button>
    {askOn && (
      <div class="home-actions">
        <a class="btn primary" href={href("ask")}><Icon name="chat" /><span>Ask<span class="wide"> the manual</span></span></a>
      </div>
    )}
    <nav class="home-recent" aria-label="Recently viewed" hidden>
      <span class="lab">Recent</span>
      <div class="chips"></div>
    </nav>
  </section>

  <section>
    <h2 class="label">Quick links</h2>
    <div class="quick-grid">
      {
        quick.map(([icon, title, sub, path]) => (
          <a class="quick-card" href={href(path)} {...(/^https?:/.test(path) ? { target: "_blank", rel: "noopener" } : {})}>
            <span class="qi"><Icon name={icon} /></span>
            <b>{title}</b>
            <span>{sub}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-news" data-pagefind-ignore>
    <h2 class="label">What's new</h2>
    <div class="news-list"><slot name="news" /></div>
  </section>

  <section>
    <h2 class="label">The manual</h2>
    <div class="parts-list not-content">
      {
        parts.map((p) => (
          <details class="part">
            <summary>
              <span class="pn">{p.name}</span>
              <span class="pc">{p.items.length} {p.name === "Appendices" ? "appendices" : p.items.length === 1 ? "chapter" : "chapters"}</span>
            </summary>
            <ul>
              {p.items.map((it) => (
                <li>
                  <a href={href(it.slug)}>
                    <span class="n">{it.number}</span>
                    {it.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </section>

  <section class="home-about">
    <div class="about-text">
      <slot />
      <div class="about-actions">
        <a class="btn donate" href={donate} target="_blank" rel="noopener"><Icon name="heart" />Donate</a>
        <a class="btn" href={href("poster.html")} target="_blank" rel="noopener"><i class="bi bi-qr-code" aria-hidden="true"></i>Install poster (QR code)</a>
      </div>
    </div>
    <aside class="about-people" aria-label="Editor and authors">
      <p class="role">Editor</p>
      <p class="editor">{editor}</p>
      {editorEmail && <p class="editor-mail"><a href={`mailto:${editorEmail}`}><i class="bi bi-envelope" aria-hidden="true"></i>{editorEmail}</a></p>}
      <p class="role">Authors</p>
      <ul>{authors.map((a) => <li>{a}</li>)}</ul>
    </aside>
  </section>
</div>

<script>
  // the hero search box opens the site search, after this click is done (a click that is still
  // bubbling would land outside the new dialog and close it at once)
  // shortcut hint: Ctrl K on Windows, ⌘K on Apple devices (the same test Starlight's search uses)
  const shortcut = document.querySelector("[data-shortcut]");
  if (shortcut && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) shortcut.textContent = "⌘K";
  document.querySelector("[data-home-search]")?.addEventListener("click", () => {
    setTimeout(() => document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]")?.click());
  });
  // Recently viewed on this device (chapters read, and sections opened from Ask); nothing is shown on a first visit
  const LIVE = "https://fschou-pxt.github.io/RMC-NICU-Manual/";
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const recentNav = document.querySelector<HTMLElement>(".home-recent");
  try {
    const recent = (JSON.parse(localStorage.getItem("nicuChat.recent") || "[]") as { title: string; url: string }[])
      .filter((r) => r.url?.startsWith(LIVE)).slice(0, 12);
    if (recentNav && recent.length) {
      const chips = recentNav.querySelector(".chips")!;
      for (const r of recent) {
        const a = document.createElement("a");
        a.href = base + r.url.slice(LIVE.length).replace(/\.html(?=#|$)/, "");
        const parts = r.title.replace(/^(\d+|Appendix [A-Z] —)\s+/, "").split(" › ").map((x) => x.replace(/:$/, ""));
        a.textContent = parts.length > 1 ? `${parts[0]} › ${parts[parts.length - 1]}` : parts[0];
        a.title = r.title.replace(/^(\d+|Appendix [A-Z] —)\s+/, "");
        chips.append(a);
      }
      recentNav.hidden = false;
      // one line only: show the most recent chips that fit, hide the rest (rechecked when the width changes)
      const fit = () => {
        const all = [...chips.children] as HTMLElement[];
        all.forEach((c) => { c.hidden = false; });
        const top = all[0]?.offsetTop;
        all.forEach((c) => { if (c.offsetTop > top) c.hidden = true; });
      };
      fit();
      addEventListener("resize", fit);
    }
  } catch {}
  // Quick links: most-opened on this device first (visits counted in PageTools); ties keep the standard order
  try {
    const visits = JSON.parse(localStorage.getItem("nicuQuick.visits") || "{}");
    const grid = document.querySelector(".quick-grid");
    if (grid && Object.keys(visits).length) {
      const keyOf = (a: HTMLAnchorElement) => decodeURIComponent(a.getAttribute("href")!.slice(base.length)).replace(/\.html(?=#|$)/, "");
      const cards = [...grid.querySelectorAll<HTMLAnchorElement>(".quick-card")].map((a, i) => ({ a, i, n: visits[keyOf(a)] || 0 }));
      cards.sort((x, y) => y.n - x.n || x.i - y.i).forEach(({ a }) => grid.append(a));
    }
  } catch {}
  // What's new colors go by month: newest month red, next yellow, next blue (older ones are not shown)
  const tones = ["red", "yellow", "blue"];
  const months = [];
  document.querySelectorAll(".news-item").forEach((el) => {
    const m = el.dataset.month;
    if (!months.includes(m)) months.push(m);
    const i = months.indexOf(m);
    if (i < tones.length) el.dataset.tone = tones[i];
    else el.hidden = true;
  });
</script>
