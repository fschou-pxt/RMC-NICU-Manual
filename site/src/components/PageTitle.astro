---
// Chapter header: part and chapter number, title, and a row of jump links to the chapter's main sections.
import fs from "node:fs";
import path from "node:path";
import chapters from "../chapters.json";

const { entry, headings = [] } = Astro.locals.starlightRoute;
const chapter = chapters.find((c) => c.slug === entry.id);
const sections = headings.filter((h) => h.depth === 2);
// soft launch (SOFT_LAUNCH=1 at build time): a notice that this is the new version, with feedback and the old page
const softLaunch = process.env.SOFT_LAUNCH === "1";
// the same page in the old manual when it has one (a .qmd of that name in the project folder), else its home page
const hasOld = !!entry.id && entry.id !== "index" && fs.existsSync(path.resolve("..", `${entry.id}.qmd`));
const oldPage = "https://fschou-pxt.github.io/RMC-NICU-Manual/" + (hasOld ? `${entry.id}.html` : "");
---

{softLaunch && (
  <div class="soft-launch not-content" data-soft-launch>
    <span><b>New version of the NICU Manual.</b> Same content, new design. </span>
    <a href="mailto:Fu-Sheng.X.Chou@kp.org?subject=New%20NICU%20Manual%20feedback">Tell us what you think</a>
    <span aria-hidden="true">·</span>
    <a href={oldPage} data-old={hasOld ? "page" : "home"}>{hasOld ? "Open this page in the old version" : "Open the old version"}</a>
    <button type="button" aria-label="Hide this notice" data-hide>×</button>
  </div>
)}

{entry.data.template === "splash" || entry.id === "ask" ? <h1 id="_top" class="sr-only">{entry.data.title}</h1> : (
<header class="chapter-hero">
  {chapter?.part && <p class="eyebrow">{chapter.part}<span aria-hidden="true"> · </span>{/^[A-Z]$/.test(String(chapter.number)) ? "Appendix" : "Chapter"} {chapter.number}</p>}
  <h1 id="_top" data-chapter-title={chapter ? (/^[A-Z]$/.test(String(chapter.number)) ? `Appendix ${chapter.number} — ${entry.data.title}` : `${chapter.number} ${entry.data.title}`) : entry.data.title}>{entry.data.title}</h1>
  {
    sections.length > 1 && (
      <nav class="jump" aria-label="Sections in this chapter">
        {sections.map((s) => (
          <a href={`#${s.slug}`}>{s.text}</a>
        ))}
      </nav>
    )
  }
</header>
)}

<script>
  // soft-launch notice: hidden for the rest of the visit once closed; the old-version link keeps the section
  const notice = document.querySelector("[data-soft-launch]");
  if (notice) {
    try { if (sessionStorage.getItem("nicuSoftLaunch") === "hidden") notice.remove(); } catch {}
    notice.querySelector("[data-hide]")?.addEventListener("click", () => {
      notice.remove();
      try { sessionStorage.setItem("nicuSoftLaunch", "hidden"); } catch {}
    });
    const old = notice.querySelector<HTMLAnchorElement>("[data-old]");
    if (old?.dataset.old === "page") old.addEventListener("click", () => { old.href = old.href.split("#")[0] + location.hash; });
  }

  // Arriving at a section (#id): if something above it still changes size in the first seconds
  // (a diagram being drawn, an image), keep the section at the top, until the reader scrolls on their own.
  let keepAnchor = () => {};
  if (location.hash) {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target) {
      let mine = true;
      const stop = () => { mine = false; };
      ["wheel", "touchstart", "keydown", "mousedown"].forEach((e) => addEventListener(e, stop, { once: true, passive: true }));
      keepAnchor = () => { if (mine) target.scrollIntoView({ block: "start" }); };
      const watch = new ResizeObserver(() => keepAnchor());
      watch.observe(document.querySelector(".sl-markdown-content") || document.body);
      setTimeout(() => { watch.disconnect(); mine = false; }, 5000);
    }
  }

  // Flowcharts: drawn in the browser from the ```mermaid source, in the site's colors
  async function drawDiagrams() {
    const blocks = document.querySelectorAll("pre.mermaid:not([data-processed])");
    if (!blocks.length) return;
    const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@12.2.0/dist/mermaid.esm.min.mjs");
    const dark = document.documentElement.dataset.theme === "dark";
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "loose",
      theme: "base",
      themeVariables: {
        fontFamily: "Inter, system-ui, sans-serif",
        fontSize: "14px",
        primaryColor: dark ? "#1a2738" : "#eef4fa",
        primaryBorderColor: dark ? "#3b5878" : "#9fbfdc",
        primaryTextColor: dark ? "#dde5ee" : "#1d2733",
        lineColor: dark ? "#7cc0f5" : "#0068a8",
      },
      // wider boxes: labels wrap at 400px instead of Mermaid's 200px (long dose steps were 4–5 lines each)
      flowchart: { wrappingWidth: 400, nodeSpacing: 36, rankSpacing: 36, padding: 10, useMaxWidth: true },
    });
    await mermaid.run({ nodes: blocks });
    keepAnchor(); // the diagrams just changed the page's height
  }
  drawDiagrams();

  // tap an image to see it full size (diagrams are hard to read at phone width)
  document.querySelector(".sl-markdown-content")?.addEventListener("click", (ev) => {
    const img = ev.target.closest("img");
    if (!img || img.closest("a")) return;
    const layer = document.createElement("div");
    layer.className = "img-zoom";
    layer.innerHTML = `<img src="${img.currentSrc || img.src}" alt="">`;
    layer.addEventListener("click", () => layer.remove());
    document.body.append(layer);
  });
</script>
